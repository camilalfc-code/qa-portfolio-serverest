              "listen": "test",
              "script": {
                "exec": [
                  "// Testa se o status é 200\r",
                  "pm.test(\"Status 200 - Usuário encontrado\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Testa se retornou o ID correto\r",
                  "pm.test(\"ID do usuário está correto\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData._id).to.eql(pm.collectionVariables.get(\"usuarioId\"));\r",
                  "});\r",
                  "\r",
                  "// Testa se o nome está presente\r",
                  "pm.test(\"Campo nome está presente\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"nome\");\r",
                  "});"
