        {
          "name": "POST Cadastrar Usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();\r",
                  "pm.collectionVariables.set(\"usuarioId\", jsonData._id);\r",
                  "\r",
                  "pm.test(\"Status 201 - Cadastro realizado com sucesso\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Mensagem de sucesso no body\", function () {\r",
                  "    pm.expect(jsonData.message).to.exist;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = new Date().getTime();\r",
                  "pm.collectionVariables.set(\"emailDinamico\", `camila.${timestamp}@teste.com`);\r",
                  "pm.collectionVariables.set(\"emailDinamicoEdit\", `camila.edit.${timestamp}@teste.com`);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nome\": \"Camila QA Teste\",\r\n  \"email\": \"{{emailDinamico}}\",\r\n  \"password\": \"teste123\",\r\n  \"administrador\": \"true\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://serverest.dev/usuarios",
              "protocol": "https",
              "host": [
                "serverest",
                "dev"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        },
